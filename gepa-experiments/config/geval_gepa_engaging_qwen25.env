# Default v1 experiment configuration.

DATA_SOURCE=gepa-experiments/cache/tc_usr_data.json
LABEL=Engaging

TRAIN_CONTEXTS=10
VAL_CONTEXTS=3
TEST_CONTEXTS=4
SEED=42

JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
NLA_AV_CHECKPOINT=kitft/nla-qwen2.5-7b-L20-av
NLA_EXTRACTION_LAYER=20

SERVER_PORT=8000
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.90

MAX_FULL_EVALS=1
NUM_THREADS=2
OUTPUT_DIR=gepa-experiments/results/geval_gepa_engaging_qwen25
