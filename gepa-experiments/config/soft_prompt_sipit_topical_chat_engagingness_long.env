SOFT_PROMPT_RUN_SCRIPT=gepa-experiments/slurm/run_soft_prompt_sipit_job.sh
SOFT_PROMPT_MODEL=Qwen/Qwen2.5-7B-Instruct
SOFT_PROMPT_IMAGE=geval_gepa_softprompt:latest
SOFT_PROMPT_SIPIT_INPUT_DIR=gepa-experiments/results/soft_prompt_topical_chat_engagingness_long
SOFT_PROMPT_SIPIT_OUTPUT_DIR=gepa-experiments/results/soft_prompt_topical_chat_engagingness_long_sipit
SOFT_PROMPT_SIPIT_EMBEDDING_FILE=soft_prompt_embeddings.pt
SOFT_PROMPT_SIPIT_LAYER_IDX=-1
SOFT_PROMPT_SIPIT_PRECISION=4
SOFT_PROMPT_SIPIT_TOP_K=10
SOFT_PROMPT_SIPIT_STEP_SIZE=1.0
SOFT_PROMPT_SIPIT_PROJECTION_ITERS_BASE=50
SOFT_PROMPT_SIPIT_VOCAB_SCALE_FACTOR=25000
SOFT_PROMPT_SIPIT_MAX_ITERS_PER_TOKEN=500
SEED=42

GPU_SPEC=nvidia_geforce_rtx_3090:1
SLURM_EXCLUDE=deeplearn2
SLURM_MEM=28G
SLURM_TIME=06:00:00
JOB_SLUG=soft-prompt-sipit-topical_chat-engagingness-long
