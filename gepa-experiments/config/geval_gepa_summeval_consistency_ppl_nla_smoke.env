# Smoke test: SummEval consistency with PPL + NLA plumbing.
# NLA_BACKEND=dry_run is for schema/plumbing only, not scientific reporting.

DATA_SOURCE=https://raw.githubusercontent.com/nlpyang/geval/main/data/summeval.json
DATASET=summeval
DIMENSION=consistency
LABEL=Engaging

TRAIN_CONTEXTS=4
VAL_CONTEXTS=2
TEST_CONTEXTS=2
SEED=42

JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
NLA_AV_CHECKPOINT=kitft/nla-qwen2.5-7b-L20-av
NLA_EXTRACTION_LAYER=20

SERVER_PORT=18210
MAX_MODEL_LEN=12288
MAX_NUM_SEQS=2
GPU_MEMORY_UTILIZATION=0.90

MAX_FULL_EVALS=2
NUM_THREADS=2
MAX_TOKENS=4096
INSTRUCTION_PROPOSER=generalizing
PERPLEXITY_FEEDBACK=1
PERPLEXITY_PROMPT_LOGPROBS=20
NLA_FEEDBACK=1
NLA_BACKEND=dry_run
NLA_MAX_TOKENS_PER_EXAMPLE=4
OUTPUT_DIR=gepa-experiments/results/geval_gepa_summeval_consistency_ppl_nla_smoke
SLURM_MEM=30G
SLURM_TIME=04:00:00
