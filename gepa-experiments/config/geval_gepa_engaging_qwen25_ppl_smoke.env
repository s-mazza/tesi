# Short smoke test for GEPA with numeric response perplexity feedback.

DATA_SOURCE=gepa-experiments/cache/tc_usr_data.json
LABEL=Engaging

TRAIN_CONTEXTS=4
VAL_CONTEXTS=2
TEST_CONTEXTS=2
SEED=42

JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
NLA_AV_CHECKPOINT=kitft/nla-qwen2.5-7b-L20-av
NLA_EXTRACTION_LAYER=20

SERVER_PORT=8000
MAX_MODEL_LEN=12288
MAX_NUM_SEQS=2
GPU_MEMORY_UTILIZATION=0.90

MAX_FULL_EVALS=2
NUM_THREADS=2
MAX_TOKENS=4096
INSTRUCTION_PROPOSER=generalizing
PERPLEXITY_FEEDBACK=1
PERPLEXITY_PROMPT_LOGPROBS=20
OUTPUT_DIR=gepa-experiments/results/geval_gepa_engaging_qwen25_ppl_smoke
SLURM_MEM=30G
SLURM_TIME=04:00:00
