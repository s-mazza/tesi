# Multi-hour GEPA run for long prompt convergence testing.

DATA_SOURCE=gepa-experiments/cache/tc_usr_data.json
LABEL=Engaging

TRAIN_CONTEXTS=40
VAL_CONTEXTS=10
TEST_CONTEXTS=10
SEED=42

JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
NLA_AV_CHECKPOINT=kitft/nla-qwen2.5-7b-L20-av
NLA_EXTRACTION_LAYER=20

SERVER_PORT=8000
MAX_MODEL_LEN=12288
MAX_NUM_SEQS=2
GPU_MEMORY_UTILIZATION=0.90

MAX_FULL_EVALS=60
NUM_THREADS=2
MAX_TOKENS=4096
INSTRUCTION_PROPOSER=generalizing
OUTPUT_DIR=gepa-experiments/results/geval_gepa_engaging_qwen25_2h
SLURM_TIME=04:00:00
