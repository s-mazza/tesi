DATA_SOURCE=gepa-experiments/cache/tc_usr_data.json
DATASET=topical_chat
DIMENSION=engagingness

TRAIN_CONTEXTS=40
VAL_CONTEXTS=10
TEST_CONTEXTS=10
SEED=42

SOFT_PROMPT_MODEL=Qwen/Qwen2.5-7B-Instruct
SOFT_PROMPT_IMAGE=geval_gepa_softprompt:latest
SOFT_PROMPT_OUTPUT_DIR=gepa-experiments/results/soft_prompt_topical_chat_engagingness_long_2048
SOFT_PROMPT_NUM_VIRTUAL_TOKENS=16
SOFT_PROMPT_MAX_SEQ_LEN=2048
SOFT_PROMPT_MAX_NEW_TOKENS=16
SOFT_PROMPT_TRAIN_BATCH_SIZE=1
SOFT_PROMPT_GRADIENT_ACCUMULATION_STEPS=8
SOFT_PROMPT_EVAL_BATCH_SIZE=1
SOFT_PROMPT_LEARNING_RATE=0.005
SOFT_PROMPT_EPOCHS=5
SOFT_PROMPT_WARMUP_RATIO=0.05

GPU_SPEC=nvidia_geforce_rtx_3090:1
SLURM_EXCLUDE=deeplearn2
SLURM_MEM=28G
SLURM_TIME=04:00:00
JOB_SLUG=soft-prompt-topical_chat-engagingness-long-2048
