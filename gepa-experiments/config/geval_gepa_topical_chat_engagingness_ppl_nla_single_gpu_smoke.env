# Single-GPU smoke test: Topical-Chat engagingness with PPL and real NLA precompute.
# This validates the NLA/vLLM/GEPA plumbing while the 2-GPU Qwen35B proposer job waits for faretra.

DATA_SOURCE=gepa-experiments/cache/tc_usr_data.json
DATASET=topical_chat
DIMENSION=engagingness
LABEL=Engaging

TRAIN_CONTEXTS=2
VAL_CONTEXTS=1
TEST_CONTEXTS=1
SEED=42

JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
NLA_AV_CHECKPOINT=kitft/nla-qwen2.5-7b-L20-av
NLA_EXTRACTION_LAYER=20

SERVER_PORT=18203
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.85

MAX_FULL_EVALS=1
NUM_THREADS=1
MAX_TOKENS=2048
INSTRUCTION_PROPOSER=generalizing
PERPLEXITY_FEEDBACK=1
PERPLEXITY_PROMPT_LOGPROBS=20

NLA_FEEDBACK=1
NLA_BACKEND=precomputed
NLA_PRECOMPUTED_AUTO=1
NLA_PRECOMPUTE_SPLIT=gepa
NLA_PRECOMPUTE_LIMIT=6
NLA_MAX_TOKENS_PER_EXAMPLE=2
NLA_PRECOMPUTE_MAX_NEW_TOKENS=64
NLA_PRECOMPUTE_TEMPERATURE=0.0
NLA_ACTIVATION_DTYPE=float16
NLA_VERBALIZER_DTYPE=float16
NLA_DEVICE_MAP=auto

GPU_SPEC=nvidia_geforce_rtx_3090:1
OUTPUT_DIR=gepa-experiments/results/geval_gepa_topical_chat_engagingness_ppl_nla_single_gpu_smoke
SLURM_MEM=30G
KEEP_MAIN_CONTAINER_ON_FAIL=1
