# Smoke control: QAGS-CNN consistency with PPL feedback only.
# Matched to the real-NLA smoke split/budget for technical ablation.

DATA_SOURCE=https://raw.githubusercontent.com/W4ngatang/qags/master/data/mturk_cnndm.jsonl
DATASET=qags_cnn
DIMENSION=consistency
LABEL=Consistency

TRAIN_CONTEXTS=4
VAL_CONTEXTS=2
TEST_CONTEXTS=2
SEED=42

JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
NLA_AV_CHECKPOINT=kitft/nla-qwen2.5-7b-L20-av
NLA_EXTRACTION_LAYER=20

SERVER_PORT=18231
MAX_MODEL_LEN=12288
MAX_NUM_SEQS=2
GPU_MEMORY_UTILIZATION=0.90

MAX_FULL_EVALS=2
NUM_THREADS=2
MAX_TOKENS=4096
INSTRUCTION_PROPOSER=generalizing
PERPLEXITY_FEEDBACK=1
PERPLEXITY_PROMPT_LOGPROBS=20

GPU_SPEC=nvidia_geforce_rtx_3090:1
SLURM_NODE=moro232
OUTPUT_DIR=gepa-experiments/results/geval_gepa_qags_cnn_consistency_ppl_smoke
JOB_SLUG=qags-cnn-consistency-ppl-single-gpu-smoke
SLURM_MEM=30G
SLURM_TIME=04:00:00
KEEP_MAIN_CONTAINER_ON_FAIL=1
