# Single-GPU matched smoke: Topical-Chat engagingness with PPL + real NLA.
# Matched to the PPL-only single-GPU smoke split/budget for technical audit only.

DATA_SOURCE=gepa-experiments/cache/tc_usr_data.json
DATASET=topical_chat
DIMENSION=engagingness
LABEL=Engaging

TRAIN_CONTEXTS=4
VAL_CONTEXTS=2
TEST_CONTEXTS=2
SEED=42

JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
NLA_AV_CHECKPOINT=kitft/nla-qwen2.5-7b-L20-av
NLA_EXTRACTION_LAYER=20

SERVER_PORT=18213
MAX_MODEL_LEN=12288
MAX_NUM_SEQS=2
GPU_MEMORY_UTILIZATION=0.90

MAX_FULL_EVALS=2
NUM_THREADS=2
MAX_TOKENS=4096
INSTRUCTION_PROPOSER=generalizing
PERPLEXITY_FEEDBACK=1
PERPLEXITY_PROMPT_LOGPROBS=20

NLA_FEEDBACK=1
NLA_BACKEND=precomputed
NLA_PRECOMPUTED_AUTO=1
NLA_PRECOMPUTE_SPLIT=gepa
NLA_MAX_TOKENS_PER_EXAMPLE=6
NLA_PRECOMPUTE_MAX_NEW_TOKENS=160
NLA_PRECOMPUTE_TEMPERATURE=0.0
NLA_ACTIVATION_DTYPE=float16
NLA_VERBALIZER_DTYPE=float16
NLA_DEVICE_MAP=auto
NLA_MIN_COVERAGE=0.95

GPU_SPEC=nvidia_geforce_rtx_3090:1
SLURM_NODE=moro232
OUTPUT_DIR=gepa-experiments/results/geval_gepa_topical_chat_engagingness_ppl_nla_single_gpu_matched_smoke
JOB_SLUG=topical-chat-engagingness-ppl-real-nla-single-gpu-matched-smoke
SLURM_MEM=30G
SLURM_TIME=04:00:00
KEEP_MAIN_CONTAINER_ON_FAIL=1
