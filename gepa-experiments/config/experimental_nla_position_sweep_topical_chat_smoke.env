# Base config for isolated NLA token-position sweep smoke jobs.
#
# Defaults are written with shell parameter expansion so the sweep submitter can
# override them per strategy while standalone preflight still sees a complete
# config.

DATA_SOURCE=gepa-experiments/cache/tc_usr_data.json
DATASET=topical_chat
DIMENSION=engagingness
LABEL=Engaging

TRAIN_CONTEXTS=4
VAL_CONTEXTS=2
TEST_CONTEXTS=2
SEED=42

JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
NLA_AV_CHECKPOINT=kitft/nla-qwen2.5-7b-L20-av
NLA_EXTRACTION_LAYER=20

MAX_MODEL_LEN=12288
MAX_NUM_SEQS=2
GPU_MEMORY_UTILIZATION=0.90
JUDGE_MIN_FREE_MEMORY_MIB=22500
PROPOSER_MIN_FREE_MEMORY_MIB=22500
GPU_MEMORY_WAIT_SECONDS=300
GPU_MEMORY_POLL_SECONDS=60

MAX_FULL_EVALS=2
NUM_THREADS=2
MAX_TOKENS=4096
INSTRUCTION_PROPOSER=generalizing
PERPLEXITY_FEEDBACK=1
PERPLEXITY_PROMPT_LOGPROBS=20

NLA_FEEDBACK=1
NLA_BACKEND=precomputed
NLA_PRECOMPUTED_AUTO=0
NLA_PRECOMPUTE_SPLIT=gepa
NLA_MAX_TOKENS_PER_EXAMPLE=10
NLA_PRECOMPUTE_MAX_NEW_TOKENS=160
NLA_PRECOMPUTE_TEMPERATURE=0.0
NLA_ACTIVATION_DTYPE=float16
NLA_VERBALIZER_DTYPE=float16
NLA_DEVICE_MAP=auto
NLA_MIN_COVERAGE=0.95
EXPERIMENTAL_NLA_TOKEN_STRATEGY=${EXPERIMENTAL_NLA_TOKEN_STRATEGY:-candidate_middle_1}

PROPOSER_BACKEND=llamacpp
PROPOSER_MODEL=local-llamacpp
SERVER_PORT=${SERVER_PORT:-18220}
PROPOSER_PORT=${PROPOSER_PORT:-18221}
PROPOSER_TEMPERATURE=0.7
PROPOSER_MAX_TOKENS=4096
LLAMACPP_HF_MODEL=opensota/Qwen3.6-35B-A3B-GGUF:UD-Q4_K_M
LLAMACPP_MODEL_DIR=/llms/llamacpp-cache
LLAMACPP_MODEL_NAME=opensota_Qwen3.6-35B-A3B-GGUF_Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
LLAMACPP_CTX_SIZE=8192
LLAMACPP_PARALLEL=1
LLAMACPP_BATCH_SIZE=128
LLAMACPP_FLASH_ATTN=on
LLAMA_API_KEY=local-llamacpp-key

GPU_SPEC=nvidia_geforce_rtx_3090:2
SLURM_EXCLUDE=deeplearn2
OUTPUT_DIR=${OUTPUT_DIR:-gepa-experiments/results/experimental_nla_${EXPERIMENTAL_NLA_TOKEN_STRATEGY}_topical_chat_smoke}
JOB_SLUG=${JOB_SLUG:-experimental-nla-${EXPERIMENTAL_NLA_TOKEN_STRATEGY}-topical_chat-engagingness}
SLURM_MEM=64G
SLURM_TIME=04:00:00
KEEP_MAIN_CONTAINER_ON_FAIL=1
