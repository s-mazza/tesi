# Longer GEPA run that lets the optimizer propose long judge prompts.

DATA_SOURCE=gepa-experiments/cache/tc_usr_data.json
LABEL=Engaging

TRAIN_CONTEXTS=10
VAL_CONTEXTS=3
TEST_CONTEXTS=4
SEED=42

JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
NLA_AV_CHECKPOINT=kitft/nla-qwen2.5-7b-L20-av
NLA_EXTRACTION_LAYER=20

SERVER_PORT=8000
MAX_MODEL_LEN=12288
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.90

MAX_FULL_EVALS=6
NUM_THREADS=1
MAX_TOKENS=4096
OUTPUT_DIR=gepa-experiments/results/geval_gepa_engaging_qwen25_long
