# Isolated smoke experiment: hybrid NLA token strategy with deduplicated context-level feedback.
#
# Candidate tokens are still per response. Source/reference tokens are extracted once per
# dialogue context and then reused by the NLA feedback provider through __group__ rows.
# This keeps grounding signal without repeating identical source/reference activations for
# every candidate response in the same context.

DATA_SOURCE=gepa-experiments/cache/tc_usr_data.json
DATASET=topical_chat
DIMENSION=engagingness
LABEL=Engaging

TRAIN_CONTEXTS=4
VAL_CONTEXTS=2
TEST_CONTEXTS=2
SEED=42

JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct
NLA_AV_CHECKPOINT=kitft/nla-qwen2.5-7b-L20-av
NLA_EXTRACTION_LAYER=20

SERVER_PORT=18183
MAX_MODEL_LEN=12288
MAX_NUM_SEQS=2
GPU_MEMORY_UTILIZATION=0.90

MAX_FULL_EVALS=2
NUM_THREADS=2
MAX_TOKENS=4096
INSTRUCTION_PROPOSER=generalizing
PERPLEXITY_FEEDBACK=1
PERPLEXITY_PROMPT_LOGPROBS=20

NLA_FEEDBACK=1
NLA_BACKEND=precomputed
NLA_PRECOMPUTED_AUTO=0
NLA_PRECOMPUTE_SPLIT=gepa
NLA_MAX_TOKENS_PER_EXAMPLE=6
NLA_PRECOMPUTE_MAX_NEW_TOKENS=160
NLA_PRECOMPUTE_TEMPERATURE=0.0
NLA_ACTIVATION_DTYPE=float16
NLA_VERBALIZER_DTYPE=float16
NLA_DEVICE_MAP=auto
NLA_MIN_COVERAGE=0.95
EXPERIMENTAL_NLA_TOKEN_STRATEGY=hybrid_context_dedup_6

PROPOSER_BACKEND=llamacpp
PROPOSER_MODEL=local-llamacpp
PROPOSER_PORT=18184
PROPOSER_TEMPERATURE=0.7
PROPOSER_MAX_TOKENS=4096
LLAMACPP_HF_MODEL=opensota/Qwen3.6-35B-A3B-GGUF:UD-Q4_K_M
LLAMACPP_MODEL_DIR=/llms/llamacpp-cache
LLAMACPP_MODEL_NAME=opensota_Qwen3.6-35B-A3B-GGUF_Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
LLAMACPP_CTX_SIZE=8192
LLAMACPP_PARALLEL=1
LLAMACPP_BATCH_SIZE=64
LLAMACPP_FLASH_ATTN=off
LLAMA_API_KEY=local-llamacpp-key

GPU_SPEC=nvidia_geforce_rtx_3090:2
SLURM_EXCLUDE=deeplearn2
OUTPUT_DIR=gepa-experiments/results/experimental_nla_hybrid_context_dedup_6_topical_chat_smoke
SLURM_MEM=64G
SLURM_TIME=04:00:00
JOB_SLUG=experimental-nla-hybrid_context_dedup_6-topical_chat-engagingness
KEEP_MAIN_CONTAINER_ON_FAIL=1
